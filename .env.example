APP_NAME=Procurement Agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=procurement_agent
MYSQL_USER=procurement_agent_app
MYSQL_PASSWORD=replace_with_generated_password
MYSQL_ROOT_PASSWORD=replace_with_generated_root_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=replace_with_generated_password
REDIS_DB=0
AGENT_SESSION_TTL_SECONDS=259200

IDENTITY_GATEWAY_SECRET=replace_with_generated_gateway_secret
IDENTITY_SIGNATURE_TTL_SECONDS=300
IDENTITY_NONCE_TTL_SECONDS=300

NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
NOTIFICATION_REQUEST_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=86400
NOTIFICATION_WORKER_BATCH_SIZE=50

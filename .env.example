APP_NAME=Procurement Agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

AGENT_APP_NAME=Procurement Mind Agent
AGENT_APP_ENV=development
AGENT_DEBUG=true
AGENT_LOG_LEVEL=INFO
PERFORMANCE_OPTIMIZATIONS_ENABLED=true
AGENT_HOST=127.0.0.1
AGENT_PORT=8100
AGENT_API_V1_PREFIX=/api/v1
AGENT_SERVICE_URL=http://127.0.0.1:8100
AGENT_SERVICE_TIMEOUT_SECONDS=330
PROCUREMENT_BACKEND_URL=http://127.0.0.1:8000
PROCUREMENT_BACKEND_TIMEOUT_SECONDS=10
PROCUREMENT_BACKEND_MAX_RETRIES=1
PROCUREMENT_BACKEND_RETRY_DELAY_SECONDS=0.1
MCP_STARTUP_TIMEOUT_SECONDS=60
MCP_TOOL_TIMEOUT_SECONDS=15
MCP_SERVER_MODULE=agent_app.mcp.server
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30
MODEL_PROVIDER=
PRIMARY_MODEL=
MODEL_API_KEY=
MODEL_BASE_URL=
FALLBACK_MODEL=
MODEL_TIMEOUT_SECONDS=60
MODEL_STRUCTURED_OUTPUT_RETRIES=1
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30
EMBEDDING_MODEL_PATH=F:/AIModels/bge-m3
RERANKER_MODEL_PATH=F:/AIModels/bge-reranker-v2-m3
RAG_EMBEDDING_PROVIDER=aliyun_bailian
RAG_RERANK_PROVIDER=aliyun_bailian
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_RERANK_MODEL=qwen3-rerank
# Optional overrides. Blank values reuse MODEL_API_KEY and MODEL_BASE_URL.
RAG_API_KEY=
RAG_BAILIAN_BASE_URL=
RAG_API_TIMEOUT_SECONDS=30
RAG_API_MAX_RETRIES=2
RAG_API_RETRY_BASE_SECONDS=0.5
RAG_RERANK_INSTRUCT=Given a procurement question, retrieve relevant passages that answer the query.
RAG_MODEL_DEVICE=cpu
RAG_CPU_THREADS=4
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=procurement_knowledge_child_qwen37
QDRANT_TIMEOUT_SECONDS=10
RAG_DENSE_VECTOR_SIZE=1024
RAG_DENSE_VECTOR_NAME=dense
RAG_SPARSE_VECTOR_NAME=bm25
KNOWLEDGE_SOURCE_DIRECTORY=knowledge/source
RAG_CHILD_MAX_CHARS=800
RAG_CHILD_HARD_MAX_CHARS=2000
RAG_EMBEDDING_BATCH_SIZE=20
RAG_EMBEDDING_MAX_LENGTH=512
RAG_EMBEDDING_CACHE_SIZE=512
RAG_EMBEDDING_CACHE_TTL_SECONDS=3600
QDRANT_UPSERT_BATCH_SIZE=32
RAG_DENSE_TOP_K=15
RAG_SPARSE_TOP_K=15
RAG_FUSION_TOP_K=12
RAG_RERANK_TOP_K=5
RAG_RRF_K=60
RAG_RERANKER_BATCH_SIZE=4
RAG_RERANK_MIN_SCORE=0.5
RAG_CONTEXT_MAX_CHARS=6000
RAG_PARENT_MAX_CHARS=2400
RAG_REWRITE_CACHE_SIZE=256
RAG_REWRITE_CACHE_TTL_SECONDS=1800
RAG_RETRIEVAL_CACHE_SIZE=256
RAG_RETRIEVAL_CACHE_TTL_SECONDS=300
MAX_TOOL_CALLS=8
MAX_EXECUTION_STEPS=12
TASK_TIMEOUT_SECONDS=120
RAG_TOP_K=5
REVIEW_ENABLED=true
TRACE_ENABLED=true

ANALYTICS_QUERY_TIMEOUT_SECONDS=10
ANALYTICS_MAX_SCAN_ROWS=5000
ANALYTICS_DEFAULT_RANGE_DAYS=365
RISK_DUPLICATE_WINDOW_DAYS=30
RISK_PRICE_DEVIATION_RATIO=0.2
RISK_QUANTITY_DEVIATION_RATIO=0.5
RISK_LONG_PENDING_DAYS=14

MYSQL_HOST=127.0.0.1
MYSQL_PORT=13307
MYSQL_DATABASE=procurement_mind
MYSQL_USER=procurement_mind_app
MYSQL_PASSWORD=replace_with_generated_password
MYSQL_ROOT_PASSWORD=replace_with_generated_root_password

REDIS_HOST=127.0.0.1
REDIS_PORT=16380
REDIS_PASSWORD=replace_with_generated_password
REDIS_DB=0
AGENT_SESSION_TTL_SECONDS=259200

IDENTITY_GATEWAY_SECRET=replace_with_generated_gateway_secret
